  "compilerOptions": { "target": "ES2022", "useDefineForClassFields": true, "module": "ESNext", "lib": ["ES2022", "DOM", "DOM.Iterable"], "skipLibCheck": true, "types": ["vite/client"], "moduleResolution": "Bundler", "allowImportingTsExtensions": true, "resolveJsonModule": true, "isolatedModules": true, "verbatimModuleSyntax": true, "moduleDetection": "force", "noEmit": true, "strict": true, "baseUrl": ".", "paths": { "@/*": ["./src/*"] } },
