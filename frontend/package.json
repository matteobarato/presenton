{
  "name": "presenton-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "gen:api": "openapi-typescript ../servers/fastapi/openai_spec.json -o src/api/schema.d.ts",
    "test": "vitest run",
    "test:golden": "vitest run --config vitest.golden.config.ts",
    "e2e": "playwright test",
    "lint": "eslint .",
    "check": "vue-tsc -b && vitest run && eslint ."
  },
  "dependencies": {
    "@tanstack/vue-query": "^5.106.1",
    "@vueuse/core": "^15.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "dompurify": "^3.4.17",
    "jsonrepair": "^3.15.0",
    "katex": "^0.19.1",
    "lucide-vue-next": "^1.0.0",
    "openapi-fetch": "^0.17.0",
    "pinia": "^4.1.0",
    "presenton-frontend": "link:",
    "reka-ui": "^2.11.0",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.45",
    "vue-router": "^5.4.0",
    "vue-sonner": "^2.0.9",
    "vuedraggable": "^4.1.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.65.0",
    "@tailwindcss/vite": "^4.3.4",
    "@types/dompurify": "^3.0.5",
    "@types/node": "^22.20.5",
    "@vitejs/plugin-vue": "^6.0.10",
    "@vue/eslint-config-typescript": "^14.9.0",
    "@vue/test-utils": "^2.5.1",
    "eslint": "^10.14.0",
    "eslint-plugin-vue": "^10.12.0",
    "jsdom": "^31.0.0",
    "openapi-typescript": "^7.13.0",
    "tailwindcss": "^4.3.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.72.1",
    "vite": "^6.4.5",
    "vitest": "^5.1.0",
    "vue-tsc": "^3.3.14"
  }
}
